# Configuration of the web service (node dist/index.js) and the deletion worker (node dist/worker.js).
# Both processes read the same variables. Never commit real secrets; set them as service environment variables.

# Network: the service listens on localhost only; IIS terminates TLS and forwards to it.
HOST=127.0.0.1
PORT=3000
# Origin as seen by browsers. Used for the OAuth callback, cookies (__Host- prefix over HTTPS) and CSRF checks.
PUBLIC_URL=https://apps.example.com
# Read client addresses from X-Forwarded-For (set by IIS/ARR).
TRUST_PROXY=true

# Storage on a local NTFS volume, outside every IIS webroot.
DATABASE_PATH=D:\AppDistribution\data\distribution.db
STORAGE_ROOT=D:\AppDistribution\storage
# Directories served by IIS, separated by ";". The storage root must not overlap with any of them.
SERVED_AREAS=D:\AppDistribution\app\public

# GitHub OAuth app (scope read:org) on github.com or GitHub Enterprise. Callback URL: <PUBLIC_URL>/auth/github/callback
# GITHUB_WEB_URL defaults to https://github.com; set it to the host for GitHub Enterprise Server or GHE.com.
# GITHUB_API_URL is derived from it (api.github.com, api.<sub>.ghe.com, <host>/api/v3) and only needed to override.
# On github.com the organisation may restrict OAuth app access: an owner must approve the app, otherwise every
# sign-in fails the membership check.
GITHUB_WEB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Membership of this organisation is required to sign in; it grants no permissions.
GITHUB_ORGANIZATION=
# Numeric GitHub user ids (not logins) of the initial platform administrators, separated by ",".
# Look one up with: GET <GITHUB_API_URL>/users/<login>  ->  "id"
BOOTSTRAP_ADMIN_GITHUB_IDS=

# CI uploads (GitHub Action in src/action/): jobs authenticate with their OIDC token. The issuer is derived from
# GITHUB_WEB_URL (token.actions.githubusercontent.com, token.actions.<sub>.ghe.com, <host>/_services/token) and the
# audience is the origin of PUBLIC_URL; set these only to override.
# CI_OIDC_ISSUER=https://token.actions.githubusercontent.com
# CI_OIDC_AUDIENCE=https://apps.example.com

# iOS installation links (itms-services): iOS loads manifest and IPA without cookies, so the link carries a
# signed token. At least 32 random characters, e.g. `openssl rand -base64 48`; changing it invalidates open links.
INSTALL_LINK_SECRET=

# Deletion worker: how often it looks for due jobs and how long it reserves one.
WORKER_POLL_SECONDS=30
WORKER_LEASE_MINUTES=15

# Start values of settings that administrators change on the settings page (/settings.html). They apply only on
# the very first start, when the settings are created; changing them afterwards has no effect.
INSTALL_LINK_MINUTES=10
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
QUARANTINE_RETENTION_DAYS=7
RECONCILE_HOURS=24
