{
  "name": "devx-template-typescript",
  "version": "1.1.2",
  "description": "Template for building maintainable, well-tested applications and libraries in TypeScript.",
  "author": "Lukas Kuntze",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukas-kuntze/devx-template-typescript.git"
  },
  "keywords": [
    "developer-experience",
    "node",
    "template",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
