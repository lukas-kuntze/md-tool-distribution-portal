root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[.githooks/*]
indent_size = 4

[*.json]
indent_size = 2
indent_style = space

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{ts,js}]
indent_size = 2
indent_style = space

[*.xml]
indent_size = 4
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space
