{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "noEmit": false,

    // Runs on the Node runtime of GitHub Actions; no browser globals.
    "lib": ["ES2024"],
    "types": ["node"],

    "rootDir": ".",
    "outDir": "./dist",
    "sourceMap": false,
    "declaration": false
  },

  "include": ["*.ts"],
  "exclude": ["*.test.ts", "dist"]
}
