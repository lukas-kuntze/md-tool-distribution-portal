{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noEmit": false,

    // The backend runs on Node; browser globals stay out of reach.
    "lib": ["ES2024"],

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/frontend", "src/action", "**/*.test.ts"]
}
